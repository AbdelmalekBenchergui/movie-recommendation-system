# ── AWS ──
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# ── S3 ──
ML_BUCKET=recsys-dev-bucket
MODEL_S3_PREFIX=ml/models
INPUT_S3_PREFIX=ml/input
CODE_S3_PREFIX=ml/retrain-code
STREAMING_PREFIX=raw/streaming/ratings

# ── Glue / Athena ──
GLUE_DATABASE=recsys_dev_db
ATHENA_WORKGROUP=recsys-dev-athena

# ── SageMaker / Step Functions ──
SAGEMAKER_INSTANCE_TYPE=ml.m5.large
STATE_MACHINE_NAME=recsys-dev-retrain

# ── Serving Lambda (set by Deploy stage, read by recommend.py) ──
MODEL_PREFIX=ml/models/<run>

# ── Pipeline Lambdas ──
RECOMMEND_FUNCTION_NAME=recsys-dev-recommend
MODEL_PREFIX_PARAM=/recsys/dev/model-prefix
API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/prod
