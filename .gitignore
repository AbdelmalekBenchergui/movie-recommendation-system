# Terraform (state + local config, must never be committed)
terraform/.terraform/
terraform/*.tfstate*
terraform/*.tfplan
terraform/.terraform.lock.hcl
**/.terraform/
*.tfplan
terraform/*.tfvars
terraform/*.tfvars.json

# AWS / secrets
.aws/
.env
.env.*
!.env.example

# Local data (large dataset, not for version control)
data/

# Local build artifacts
.build/
*.zip

# IDE
.vscode/
.idea/
*.swp

# Logs
*.log

# Python
__pycache__/
*.pyc
.venv/
venv/
docs/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
